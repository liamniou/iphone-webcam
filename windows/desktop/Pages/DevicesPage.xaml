<Page x:Class="IPhoneWebcam.Desktop.Pages.DevicesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Mobile devices">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,20,32,32" MaxWidth="1000">
            <TextBlock Text="Mobile devices" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,20" />

            <ui:CardControl Icon="{ui:SymbolIcon Phone24}" Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock x:Name="CurrentDeviceTitle" Text="No iPhone connected" />
                        <TextBlock x:Name="CurrentDeviceText" Style="{StaticResource SecondaryText}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button x:Name="DisconnectButton" Content="Disconnect" Icon="{ui:SymbolIcon PlugDisconnected24}" Click="OnDisconnectClick" />
            </ui:CardControl>

            <ui:CardControl Icon="{ui:SymbolIcon Link24}" Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Connect by IP address" />
                        <TextBlock Text="If your iPhone isn't found automatically, enter the IP address shown in the iPhone app."
                                   Style="{StaticResource SecondaryText}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:TextBox x:Name="AddressBox" Width="190" PlaceholderText="192.168.1.23" KeyDown="OnAddressKeyDown" />
                    <ui:Button Content="Connect" Appearance="Primary" Margin="8,0,0,0" Click="OnConnectClick" />
                </StackPanel>
            </ui:CardControl>
            <ui:InfoBar x:Name="AddressError" Severity="Error" IsClosable="True" Title="Can't connect" Margin="0,0,0,4" />

            <ui:CardControl Icon="{ui:SymbolIcon ArrowSync24}" Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Reconnect automatically" />
                        <TextBlock Text="Keep retrying when the connection drops, and connect to the last iPhone when the app starts."
                                   Style="{StaticResource SecondaryText}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="AutoReconnectSwitch" Checked="OnAutoReconnectChanged" Unchecked="OnAutoReconnectChanged" />
            </ui:CardControl>

            <ui:CardControl Icon="{ui:SymbolIcon Search24}" Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Search for iPhones" />
                        <TextBlock x:Name="DiscoveryText" Style="{StaticResource SecondaryText}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="Search again" Icon="{ui:SymbolIcon ArrowSync24}" Click="OnRefreshClick" />
            </ui:CardControl>

            <TextBlock Text="iPhone app" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,10" />

            <ui:CardControl Icon="{ui:SymbolIcon ArrowDownload24}" Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Install the iPhone app" />
                        <TextBlock Text="Sideload it with Sideloadly or AltStore using your Apple ID, or build it with Xcode."
                                   Style="{StaticResource SecondaryText}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="Instructions" Icon="{ui:SymbolIcon Open24}" Click="OnInstructionsClick" />
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</Page>
