<Page x:Class="IPhoneWebcam.Desktop.Pages.VideoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Video">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,20,32,32" MaxWidth="1000">
            <TextBlock Text="Video" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,20" />

            <ui:CardControl Icon="{ui:SymbolIcon Video24}" Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Virtual camera" />
                        <TextBlock x:Name="CameraText" Style="{StaticResource SecondaryText}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <TextBlock x:Name="CameraStateText" VerticalAlignment="Center" />
            </ui:CardControl>

            <ui:CardControl Icon="{ui:SymbolIcon SlideSize24}" Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Resolution" />
                        <TextBlock Text="What the iPhone sends and the virtual camera provides. Apps already using the camera switch after they turn their camera off and on."
                                   Style="{StaticResource SecondaryText}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox x:Name="FormatCombo" MinWidth="180" DisplayMemberPath="Label" SelectionChanged="OnFormatChanged"
                          AutomationProperties.Name="Resolution" />
            </ui:CardControl>
            <TextBlock x:Name="FormatDescription" Style="{StaticResource SecondaryText}" Margin="52,0,0,4" />

            <TextBlock Text="Performance" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,10" />

            <ui:CardControl Icon="{ui:SymbolIcon BrainCircuit24}" Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Decode on the GPU" />
                        <TextBlock x:Name="DecoderText" Style="{StaticResource SecondaryText}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="GpuSwitch" Checked="OnGpuChanged" Unchecked="OnGpuChanged" />
            </ui:CardControl>

            <ui:CardControl Icon="{ui:SymbolIcon Sparkle24}" Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Auto-framing and retouch" />
                        <TextBlock x:Name="EffectsText" Style="{StaticResource SecondaryText}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <TextBlock x:Name="EffectsState" VerticalAlignment="Center" />
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</Page>
