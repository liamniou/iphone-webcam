<Page x:Class="IPhoneWebcam.Desktop.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="About">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,20,32,32" MaxWidth="1000">
            <TextBlock Text="About" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,20" />

            <Border Style="{StaticResource Surface}" Padding="20" Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Assets/AppIcon.ico" Width="56" Height="56" />
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="iPhone Webcam" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource SecondaryText}" FontSize="13" Margin="0,2,0,0" />
                        <TextBlock Text="Use your iPhone as a 4K webcam on Windows." Style="{StaticResource SecondaryText}" FontSize="13" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <ui:CardAction Icon="{ui:SymbolIcon Code24}" Margin="0,0,0,4" Click="OnSourceClick">
                <StackPanel>
                    <TextBlock Text="Source code" />
                    <TextBlock Text="github.com/liamniou/iphone-webcam" Style="{StaticResource SecondaryText}" />
                </StackPanel>
            </ui:CardAction>
            <ui:CardAction Icon="{ui:SymbolIcon QuestionCircle24}" Margin="0,0,0,4" Click="OnHelpClick">
                <StackPanel>
                    <TextBlock Text="Help and troubleshooting" />
                    <TextBlock Text="Installation, usage and common problems" Style="{StaticResource SecondaryText}" />
                </StackPanel>
            </ui:CardAction>
            <ui:CardAction Icon="{ui:SymbolIcon PersonFeedback24}" Margin="0,0,0,4" Click="OnIssueClick">
                <StackPanel>
                    <TextBlock Text="Report a problem" />
                    <TextBlock Text="Open an issue on GitHub" Style="{StaticResource SecondaryText}" />
                </StackPanel>
            </ui:CardAction>

            <TextBlock Text="Licenses" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,10" />
            <ui:CardAction Icon="{ui:SymbolIcon Document24}" Margin="0,0,0,4" Click="OnLicenseClick">
                <StackPanel>
                    <TextBlock Text="iPhone Webcam" />
                    <TextBlock Text="Apache License 2.0" Style="{StaticResource SecondaryText}" />
                </StackPanel>
            </ui:CardAction>
            <ui:CardAction Icon="{ui:SymbolIcon Box24}" Margin="0,0,0,4" Click="OnWpfUiClick">
                <StackPanel>
                    <TextBlock Text="WPF UI" />
                    <TextBlock Text="Fluent controls by Leszek Pomianowski and contributors — MIT License" Style="{StaticResource SecondaryText}" />
                </StackPanel>
            </ui:CardAction>
        </StackPanel>
    </ScrollViewer>
</Page>
