<ui:FluentWindow x:Class="IPhoneWebcam.Desktop.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:pages="clr-namespace:IPhoneWebcam.Desktop.Pages"
                 Title="Settings – iPhone Webcam" Width="940" Height="700" MinWidth="720" MinHeight="500"
                 Icon="Assets/AppIcon.ico" WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Height="40" ShowMinimize="False" CloseWindowByDoubleClickOnIcon="False">
            <ui:TitleBar.Header>
                <TextBlock Text="Settings" Margin="16,0,0,0" FontSize="12" VerticalAlignment="Center" />
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <ui:NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Left" OpenPaneLength="250"
                           IsBackButtonVisible="Collapsed" IsPaneToggleVisible="True" Padding="0">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="General" Icon="{ui:SymbolIcon Home24}" TargetPageType="{x:Type pages:GeneralPage}" />
                <ui:NavigationViewItem Content="Mobile devices" Icon="{ui:SymbolIcon Phone24}" TargetPageType="{x:Type pages:DevicesPage}" />
                <ui:NavigationViewItem Content="Video" Icon="{ui:SymbolIcon Video24}" TargetPageType="{x:Type pages:VideoPage}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="About" Icon="{ui:SymbolIcon Info24}" TargetPageType="{x:Type pages:AboutPage}" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
