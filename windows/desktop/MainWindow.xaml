<ui:FluentWindow x:Class="IPhoneWebcam.Desktop.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="iPhone Webcam" Width="1280" Height="800" MinWidth="1000" MinHeight="640"
                 Icon="Assets/AppIcon.ico" WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
                 UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar: app name, live status badges, panel + settings buttons -->
        <ui:TitleBar Grid.Row="0" Height="48" CloseWindowByDoubleClickOnIcon="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/AppIcon.ico" Width="20" Height="20" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="iPhone Webcam" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock x:Name="VersionText" Margin="8,1,0,0" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </ui:TitleBar.Header>
            <ui:TitleBar.CenterContent>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="28,0,0,0">
                    <Border x:Name="CameraPill" CornerRadius="4" Padding="10,5" BorderThickness="1"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="CameraDot" Width="8" Height="8" VerticalAlignment="Center" />
                            <TextBlock x:Name="CameraPillText" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="FormatBadge" Margin="8,0,0,0" CornerRadius="4" Padding="8,2" BorderThickness="1"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            ToolTip="Resolution and frame rate received from the iPhone">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="FormatResolution" FontSize="10" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="FormatFps" FontSize="10" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ui:TitleBar.CenterContent>
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                    <ui:Button x:Name="StatusPanelButton" Appearance="Transparent" BorderThickness="0" Padding="8"
                               Icon="{ui:SymbolIcon PanelRight24}" ToolTip="Show or hide the status panel" AutomationProperties.Name="Status panel"
                               WindowChrome.IsHitTestVisibleInChrome="True" Click="OnStatusPanelClick" />
                    <ui:Button Appearance="Transparent" BorderThickness="0" Padding="8" Margin="2,0,0,0"
                               Icon="{ui:SymbolIcon Settings24}" ToolTip="Settings" AutomationProperties.Name="Settings"
                               WindowChrome.IsHitTestVisibleInChrome="True" Click="OnSettingsClick" />
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left panel: device and effects -->
            <Border Grid.Column="0" Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,1,0" CornerRadius="0,8,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,12,12,16">

                        <!-- Current device -->
                        <Border Style="{StaticResource Surface}" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Phone24" FontSize="26" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="DeviceTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <Ellipse x:Name="StateDot" Width="8" Height="8" VerticalAlignment="Center" />
                                        <TextBlock x:Name="StateText" Margin="6,0,0,0" FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <ui:Button x:Name="ConnectToggleButton" Grid.Column="2" Padding="8" VerticalAlignment="Center"
                                           Click="OnConnectToggleClick" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="MessageText" Style="{StaticResource SecondaryText}" Margin="2,8,0,0" />

                        <!-- Device picker -->
                        <TextBlock Text="Device" Style="{StaticResource SectionLabel}" Margin="2,14,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="DeviceCombo" AutomationProperties.Name="Device" SelectionChanged="OnDeviceSelected">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Text="{Binding Endpoint}" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock x:Name="DevicePlaceholder" Text="Select a device…" IsHitTestVisible="False"
                                       Margin="12,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:Button Grid.Column="1" Margin="6,0,0,0" Padding="9" Icon="{ui:SymbolIcon ArrowSync24}"
                                       ToolTip="Search for iPhones again" AutomationProperties.Name="Search again" Click="OnRefreshClick" />
                        </Grid>
                        <TextBlock Margin="2,8,0,0" FontSize="12">
                            <Hyperlink Click="OnConnectByIpClick">Connect by IP address…</Hyperlink>
                        </TextBlock>

                        <Border Style="{StaticResource PanelDivider}" />

                        <!-- Auto-framing -->
                        <Grid>
                            <TextBlock Text="Auto-framing" Style="{StaticResource SectionLabel}" />
                            <ui:ToggleSwitch x:Name="AutoFrameSwitch" HorizontalAlignment="Right"
                                             ToolTip="Zoom in and smoothly follow your face (or all faces)"
                                             Checked="OnAutoFramingChanged" Unchecked="OnAutoFramingChanged" />
                        </Grid>
                        <Slider x:Name="FramingSlider" Margin="0,10,0,0" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10"
                                IsMoveToPointEnabled="True" ValueChanged="OnFramingChanged"
                                ToolTip="Wide: head and shoulders. Tight: head fills the picture." />
                        <Grid Margin="2,0,2,0">
                            <TextBlock Text="Wide" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="Tight" FontSize="11" HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </Grid>
                        <StackPanel x:Name="FaceStatus" Orientation="Horizontal" Margin="2,8,0,0">
                            <ui:SymbolIcon x:Name="FaceStatusIcon" Symbol="Person24" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock x:Name="FaceStatusText" Margin="6,0,0,0" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                        </StackPanel>

                        <Border Style="{StaticResource PanelDivider}" />

                        <!-- Retouch -->
                        <Grid>
                            <TextBlock Text="Retouch" Style="{StaticResource SectionLabel}" />
                            <ui:ToggleSwitch x:Name="RetouchSwitch" HorizontalAlignment="Right"
                                             ToolTip="Even out redness and smooth the skin on your face"
                                             Checked="OnRetouchChanged" Unchecked="OnRetouchChanged" />
                        </Grid>
                        <Grid Margin="2,12,2,0">
                            <TextBlock Text="Reduce redness" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="RednessValue" FontSize="12" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </Grid>
                        <Slider x:Name="RednessSlider" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10"
                                IsMoveToPointEnabled="True" ValueChanged="OnRetouchSliderChanged"
                                ToolTip="Evens out a red complexion (only skin tones on your face are changed)" />
                        <Grid Margin="2,8,2,0">
                            <TextBlock Text="Smooth skin" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="SmoothingValue" FontSize="12" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </Grid>
                        <Slider x:Name="SmoothingSlider" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10"
                                IsMoveToPointEnabled="True" ValueChanged="OnRetouchSliderChanged"
                                ToolTip="Softens skin texture while keeping eyes, hair and edges sharp" />

                        <Border Style="{StaticResource PanelDivider}" />

                        <!-- Image -->
                        <TextBlock Text="Image" Style="{StaticResource SectionLabel}" Margin="2,0,0,8" />
                        <UniformGrid Columns="2">
                            <ToggleButton x:Name="MirrorToggle" Style="{StaticResource SegmentToggle}" Margin="0,0,3,0"
                                          ToolTip="Mirror the picture horizontally" Checked="OnTransformChanged" Unchecked="OnTransformChanged">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="FlipHorizontal24" FontSize="16" />
                                    <TextBlock Text="Mirror" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="RotateToggle" Style="{StaticResource SegmentToggle}" Margin="3,0,0,0"
                                          ToolTip="Turn the picture upside down" Checked="OnTransformChanged" Unchecked="OnTransformChanged">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowRotateClockwise24" FontSize="16" />
                                    <TextBlock Text="Rotate 180°" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                        </UniformGrid>

                        <ui:InfoBar x:Name="EffectsInfoBar" Margin="0,14,0,0" Severity="Warning" IsClosable="False"
                                    Title="Effects unavailable"
                                    Message="Auto-framing and retouch need a DirectX 11 graphics card." />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Preview -->
            <Grid Grid.Column="1" Margin="20,16,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ui:InfoBar x:Name="CameraInfoBar" Grid.Row="0" Margin="0,0,0,12" Severity="Error" IsClosable="False"
                            Title="Virtual camera not available" />
                <Grid x:Name="PreviewHost" Grid.Row="1" Background="#FF1F1F1F" SizeChanged="OnPreviewSizeChanged">
                    <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel x:Name="Overlay" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
                        <ui:SymbolIcon Symbol="Video48" Filled="True" FontSize="76" Foreground="#66FFFFFF" HorizontalAlignment="Center" />
                        <TextBlock x:Name="OverlayTitle" Margin="0,12,0,0" FontSize="20" FontWeight="SemiBold"
                                   Foreground="#F2FFFFFF" HorizontalAlignment="Center" TextAlignment="Center" />
                        <TextBlock x:Name="OverlayText" Margin="0,6,0,0" FontSize="13" TextWrapping="Wrap"
                                   Foreground="#B3FFFFFF" HorizontalAlignment="Center" TextAlignment="Center" />
                    </StackPanel>
                    <Border x:Name="LiveBadge" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14"
                            Background="#B3000000" CornerRadius="4" Padding="8,3">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#FFFF453A" VerticalAlignment="Center" />
                            <TextBlock Text="LIVE" FontSize="11" FontWeight="Bold" Foreground="White" Margin="6,0,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
                <TextBlock Grid.Row="2" Margin="2,12,0,0" Style="{StaticResource SecondaryText}" FontSize="13"
                           Text="Select &quot;iPhone Webcam&quot; as the camera in Zoom, Teams, Google Meet, OBS or any other app." />
            </Grid>

            <!-- Status panel -->
            <Border x:Name="StatusPanel" Grid.Column="2" Width="280" Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="Status" Style="{StaticResource SectionLabel}" Margin="2,0,0,8" />
                        <StackPanel x:Name="StatusTiles" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
